      "Bash(node --test:*)",
      "Bash(git status)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
