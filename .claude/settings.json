  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(yarn test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn expo export:*)",
      "Bash(yarn expo start:*)",
      "Bash(node .claude/scripts/ticket-claim.mjs:*)",
      "Bash(node .claude/scripts/worktree-cleanup.mjs:*)",
