# Copy this file to `.env` and fill in the values you need.
# All EXPO_PUBLIC_* variables are inlined into the JS bundle at build time,
# so never put real secrets here — see DEPLOYMENT_HANDOFF.md.


# Supabase publishable-only config for T153.4's Auth client. Values come
# from the hosted dev project created in T153.2; the anon/publishable key
# is safe to inline into the client bundle.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
