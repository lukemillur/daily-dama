# Copy this file to `.env` and fill in the values you need.
# All EXPO_PUBLIC_* variables are inlined into the JS bundle at build time,
# so never put real secrets here — see DEPLOYMENT_HANDOFF.md.

# Optional. If set, gates the whole app behind a simple password screen
# (src/features/access-gate/). If unset, the gate is skipped and the app
# is open. Not real security — see README.md and DEPLOYMENT_HANDOFF.md.
EXPO_PUBLIC_ACCESS_PASSWORD=
