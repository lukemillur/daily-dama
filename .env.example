# Copy this file to `.env` and fill in the values you need.
# All EXPO_PUBLIC_* variables are inlined into the JS bundle at build time,
# so never put real secrets here — see DEPLOYMENT_HANDOFF.md.


# Supabase publishable-only config for the Auth and sync client. Values come
# from the hosted dev project; the anon/publishable key
# is safe to inline into the client bundle.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry DSN for automatic uncaught-exception and unhandled-promise-rejection
# capture on the web build only. Sentry DSNs are designed to be public (unlike a
# source-map-upload auth token, which is a real secret and is not configured here),
# so it is safe to inline into the client bundle.
# EXPO_PUBLIC_SENTRY_DSN=
